# Copy to .env and fill in. Never commit the filled-in .env (it is gitignored).
#
# Secrets currently live as GitHub Actions secrets, not in this file.
# For a local run, restore the values here from your own password manager.

# --- TDTU portal ---
STUDENT_ID=
PASSWORD=

# --- Crawl options (safe defaults, not secret) ---
TARGET_SEMESTER=
CRAWLER_WEEKS_AHEAD=2
EXAM_SOURCE_FALLBACK_ELEARNING=true
TARGET_EXAM_TYPES=midterm,final

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_REQUIRED=true

# --- ntfy notifications ---
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# --- Google Tasks (OAuth as the account that owns the task lists) ---
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
GOOGLE_TASKS_REFRESH_TOKEN=

# --- App options ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
